@startuml 3-1-artconnect-UC
left to right direction
skinparam shadowing false
skinparam ranksep 90
skinparam nodesep 25
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
title ArtConnect: dijagram obrazaca uporabe

' --- Primarni akteri ---
actor "Neprijavljeni posjetitelj" as Posjetitelj
actor "<i>Prijavljeni korisnik</i>" as Prijavljeni
actor "Umjetnik" as Umjetnik
actor "Organizator" as Organizator
actor "Administrator" as Admin

Umjetnik --|> Prijavljeni
Organizator --|> Prijavljeni
Admin --|> Prijavljeni

' --- Sustav ---
rectangle "ArtConnect" {
  usecase "UC-01\nRegistracija i prijava\nkorisnika" as UC01
  usecase "UC-02\nOdjava korisnika" as UC02
  usecase "UC-03\nPregled javnog sadržaja" as UC03
  usecase "UC-04\nUpravljanje profilom i\npregled obavijesti" as UC04
  usecase "UC-05\nPrijava na priliku" as UC05
  usecase "UC-06\nUpravljanje portfolijem" as UC06
  usecase "UC-07\nPraćenje i dopuna\nprijava" as UC07
  usecase "UC-08\nDodavanje događanja\nu kalendar" as UC08
  usecase "UC-09\nUpravljanje prilikama" as UC09
  usecase "UC-10\nPregled prijava i\nodabir pobjednika" as UC10
  usecase "UC-11\nPozivanje i blokiranje\numjetnika" as UC11
  usecase "UC-12\nUpravljanje platformom" as UC12
  usecase "UC-13\nPregled mjesečnih\nizvještaja" as UC13
}

' --- Sekundarni akteri ---
actor "Google OAuth 2.0" as OAuth <<vanjski sustav>>
actor "Google Maps API" as Maps <<vanjski sustav>>
actor "Google Calendar API" as Calendar <<vanjski sustav>>
actor "Vremenski okidač" as Timer <<vremenski okidač>>

' --- Neprijavljeni posjetitelj ---
Posjetitelj --> UC01
Posjetitelj --> UC03

' --- Prijavljeni korisnik (zajedničko za sve tri uloge) ---
Prijavljeni --> UC02
Prijavljeni --> UC03

' --- Umjetnik ---
Umjetnik --> UC04
Umjetnik --> UC06
Umjetnik --> UC05
Umjetnik --> UC07

' --- Organizator ---
Organizator --> UC04
Organizator --> UC09
Organizator --> UC10
Organizator --> UC11

' --- Administrator ---
Admin --> UC12
Admin --> UC13

' --- Sekundarni akteri ---
UC01 -- OAuth
UC09 -- Maps
UC09 -- Timer
UC02 -- Timer
UC08 -- Calendar

' --- Odnosi među obrascima uporabe ---
UC08 .> UC07 : <<extend>>
@enduml
